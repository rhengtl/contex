# TLS and the reverse proxy, in five lines.
#
# Caddy obtains and renews a Let's Encrypt certificate on its own, with no cron
# job and no certbot. That is the whole reason it is here rather than nginx:
# the certificate is the part of self-hosting people forget until it expires.
#
# The hostname comes from the environment (set in /opt/contex/.env) so that no
# domain is committed to this repository and the same file works if you move.

{$CONTEX_DOMAIN} {
	encode zstd gzip

	# Caddy adds X-Forwarded-For, -Proto and -Host, which is what ProxyFix in
	# contex/app.py reads. Without them the app would build http:// URLs behind
	# an https:// site and the rate limiter would see every visitor as Caddy.
	#
	# No response timeout is set. A ten-page PDF conversion is genuinely
	# minutes, gunicorn already caps it at 300s, and a shorter limit here would
	# cut real work short and report a gateway error for it.
	reverse_proxy app:8080
}
