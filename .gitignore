# Environment variables.
#
# .env carries the Gemini key, the Flask session secret and the Firebase web
# keys. The wildcard covers .env.local, .env.production and every other variant
# someone might create later; the template is the one exception.
.env
.env.*
!.env.example

# Credentials and keys.
#
# Deny-by-default: every .json is ignored, and the few that are genuinely safe
# to publish are named below. The Firebase Admin SDK service-account key is a
# .json and grants full administrative access to the project, so the blanket
# rule is the point of this section - do not replace it with a named pattern.
*.json
# Firebase project configuration - identifies the project, holds no secret.
!firebase.json
!firestore.indexes.json
!database.rules.json
# Node manifests. The lockfile is committed so `npm ci` reproduces the exact
# tree that the Firestore rules suite was verified against.
!package.json
!package-lock.json

# Certificates and private keys in any other form.
*.pem
*.key
*.p12
*.pfx
*.crt

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Test and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Flask
instance/
.webassets-cache

# Uploads and generated conversion artifacts. Runtime output, never source.
uploads/*
!uploads/.gitkeep

# Node - only used to build static/css/app.css, never at runtime.
# See tailwind.config.js. The generated stylesheet IS committed.
node_modules/

# Firebase CLI local state: emulator data, deploy caches and debug logs.
.firebase/
*.log

# Firebase Hosting's public root. It deliberately holds almost nothing - every
# dynamic route and every static asset is served by the Cloud Run service, so
# there is no build output here and no chance of publishing the source tree.
public/*
!public/robots.txt
