# Environment Variables
.env

# Firebase Service Account Keys (IMPORTANT - DO NOT COMMIT!)
*.json
!package.json
!tsconfig.json
# Firebase project config (safe to commit - contains no secrets)
!firebase.json
!firestore.indexes.json
!database.rules.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Flask
instance/
.webassets-cache

# Uploads
uploads/*
!uploads/.gitkeep

# Node - only used to build static/css/app.css, never at runtime.
# See tailwind.config.js. The generated stylesheet IS committed.
node_modules/

# Logs
*.log

# Firebase Hosting's public root. It deliberately holds almost nothing - every
# dynamic route and every static asset is served by the Cloud Run service, so
# there is no build output here and no chance of publishing the source tree.
public/*
!public/robots.txt
