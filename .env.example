# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here
FLASK_DEBUG=True
PORT=5000

# Upload Configuration
UPLOAD_FOLDER=uploads

# OCR Binaries
# Tesseract is auto-detected from PATH; set this only to pin an explicit path.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Firebase Admin SDK (server-side)
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/your-firebase-adminsdk.json
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# Firebase Web SDK (client-side, used by the Google sign-in button on /login)
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id

# ===========================================================
# AI QA layer (ai_qa.py)
# ===========================================================
# The AI does NOT do the OCR. Tesseract and pix2text still convert; the AI
# reviews what they produced against the original document and corrects it.
# Every failure path returns the converter's own output, so the app works
# without any of this configured.
#
# Default reviewer is Google Gemini on its FREE tier.
# Get a key at https://aistudio.google.com/apikey
# Server-side only - it is never sent to the browser.
GEMINI_API_KEY=
# GOOGLE_API_KEY=                    # alternative to GEMINI_API_KEY

# PRIVACY: on the free tier Google uses submitted documents to train its
# models, and the app shows a disclosure above both upload controls because of
# it. Enabling billing on the Google Cloud project (paid tier) stops that -
# set this to true to remove the disclosure.
# GEMINI_PAID_TIER=false

# Turn the review layer off entirely. Both converters keep working; results
# come straight from Tesseract / pix2text with no API call at all.
# AI_QA_ENABLED=true

# Optional second reviewer. Claude has no free tier, so it is opt-in.
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=          # alternative to ANTHROPIC_API_KEY
# AI_QA_ENABLE_FALLBACKS=true    # Claude server-side refusal fallbacks

# Reviewer selection (defaults shown).
# AI_QA_PROVIDER=gemini              # gemini | anthropic
# AI_QA_MODEL=gemini-3.1-flash-lite
# AI_QA_THINKING=high                # low | high | off  (Gemini)
# AI_QA_TEMPERATURE=0                # 0 keeps reviews deterministic
# AI_QA_EFFORT=high                  # low..max          (Claude)

# Review limits and cost control (defaults shown).
# AI_QA_MAX_API_CALLS=3        # per conversion: one review, one repair
# AI_QA_MAX_UPLOAD_MB=20       # larger files are converted but not reviewed
# AI_QA_MAX_PDF_PAGES=10       # only this many pages are shown to the reviewer
# AI_QA_RETRY_ATTEMPTS=2       # retries on a 429 / rate limit
# AI_QA_MAX_TOKENS=32000       # max output tokens per review
# AI_QA_ENABLE_COMPILE=true    # compile the reviewed .tex and repair once
# MAX_UPLOAD_MB=32             # hard request-body limit for every route

# Equation converter.
# EQUATION_MAX_REGIONS=12      # most equations detected on one page

# Image preprocessing (deskew / EXIF rotation / low-DPI upscale).
# Measured in bench/: deskew takes a 10-degree page from 28% to 99.8% accuracy.
# OCR_PREPROCESS=true

# Result retention.
# TEX_STORE_TTL_SECONDS=3600   # how long a generated .tex stays downloadable

# LaTeX engine used to validate the reviewed document. Auto-detected from PATH
# (pdflatex, xelatex, lualatex, tectonic).
# LATEX_CMD=C:\Program Files\MiKTeX\miktex\bin\x64\pdflatex.exe
# LATEX_COMPILE_TIMEOUT=120
