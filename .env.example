# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here
FLASK_DEBUG=True
PORT=5000

# Upload Configuration
UPLOAD_FOLDER=uploads

# OCR Binaries (used by the non-AI fallback only)
# Tesseract is auto-detected from PATH; set this only to pin an explicit path.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Firebase Admin SDK (server-side)
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/your-firebase-adminsdk.json
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# Firebase Web SDK (client-side, used by the Google sign-in button on /login)
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id

# ===========================================================
# Terms of Service / Privacy Policy
# ===========================================================
# Users must accept these before they can convert anything. Bump the version
# whenever the documents change materially and everyone is asked again -
# including signed-in users, whose acceptance is stored on their profile.
#
# The shipped documents (templates/legal/terms.html and privacy.html) are
# complete and written from the code, but they have NOT been reviewed by a
# lawyer and make no claim of compliance. They are written for: an individual
# operator, Philippine governing law, a worldwide audience (so they cover
# RA 10173, GDPR and CCPA), a minimum age of 16, and deletion carried out by
# hand within 30 days of an emailed request. Change any of those facts and the
# documents must change with them.
# TERMS_VERSION=1.0-2026-08-24

# ===========================================================
# AI conversion (ai_qa.py + convert.py)
# ===========================================================
# The model reads the document and writes the LaTeX. Tesseract and pix2text
# stand behind it as a local fallback for when it is unavailable - measurably
# worse, so the app warns the user and makes them choose before using it.
# Either way a conversion never comes back empty.
#
# Default provider is Google Gemini on its FREE tier.
# Get a key at https://aistudio.google.com/apikey
# Server-side only - it is never sent to the browser.
GEMINI_API_KEY=
# GOOGLE_API_KEY=                    # alternative to GEMINI_API_KEY

# PRIVACY: on the free tier Google uses submitted documents to train its
# models, and the app shows a disclosure above the upload control because of
# it. Enabling billing on the Google Cloud project (paid tier) replaces that
# with a quieter notice - the document still leaves this server either way.
# GEMINI_PAID_TIER=false

# Turn the AI off entirely. Conversion still works: every request then takes
# the local path, and users are warned and asked to confirm first.
# AI_QA_ENABLED=true

# Optional second provider. Claude has no free tier, so it is opt-in.
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=          # alternative to ANTHROPIC_API_KEY
# AI_QA_ENABLE_FALLBACKS=true    # Claude server-side refusal fallbacks

# -----------------------------------------------------------------------------
# Model selection and automatic fallback
# -----------------------------------------------------------------------------
# AI_QA_PROVIDER=gemini              # gemini | anthropic
#
# One role ships today: the conversion itself.
#
#   document   Reading-dominant: a whole page in, a whole document out. It
#              fails by not noticing a dropped line. Prefers
#              gemini-3.1-flash-lite - picked on measured full-page reading
#              (socOCRbench 0.6214, tied with the best free-tier model and
#              ahead of gemini-3.5-flash) and the cheapest of them if you ever
#              enable billing.
#
# YOU DO NOT NEED TO SWITCH MODELS BY HAND, EVER. Each role has an ordered
# chain. One conversion is one "round": it opens on the preferred model, and if
# that model returns a quota error the round advances to the next candidate and
# carries it through the remaining pages. When the chain runs out, the round
# stops calling the API and the local converters finish the document, so the
# conversion always completes. The next conversion is a new round and opens on
# the preferred model again - quota comes back without warning, and nobody
# should stay on a worse model because the best one was busy an hour ago.
#
#   document   gemini-3.1-flash-lite -> gemini-3.6-flash
#              -> gemini-3.5-flash -> gemini-3.7-flash
#
# gemini-3.7-flash is last: strongest reasoner on paper, but its free
# daily quota ran out after about a dozen calls in testing, which makes it a
# poor primary and a fine last resort.
#
# Setting one of these changes which model is PREFERRED; the built-in chain
# still stands behind whatever you name, so pinning never removes the safety
# net. A comma-separated list sets your own order at the front of the chain.
# AI_QA_MODEL_DOCUMENT=              # e.g. gemini-3.6-flash
# AI_QA_MODEL=                       # applies to every role
#
# How hard each role thinks: low | medium | high | off.
# AI_QA_THINKING_DOCUMENT=low        # reading, not deliberation
# AI_QA_THINKING=                    # applies to every role
#
# AI_QA_TEMPERATURE=0                # 0 keeps conversions deterministic
# AI_QA_EFFORT=                      # legacy alias for AI_QA_THINKING (Claude)
#
# Claude defaults to claude-sonnet-5, with no rotation: it has no
# free tier, so its 429s are short per-minute limits that clear on their own,
# and rotating to Opus would quietly raise the bill 2.5x to solve a problem
# that waiting solves for nothing. Anthropic does not train on API input, so
# this is the provider to use for documents that must not go to a free tier.

# Limits and cost control (defaults shown).
# AI_QA_MAX_API_CALLS=3        # per conversion unit: one pass, one repair
# AI_QA_MAX_UPLOAD_MB=20       # larger files are converted locally instead
# AI_QA_MAX_PDF_PAGES=10       # pages of a PDF sent to the model
# AI_QA_RETRY_ATTEMPTS=3       # retries on a 429 or an upstream 5xx
# AI_QA_MAX_TOKENS=32000       # max output tokens per call
# AI_QA_ENABLE_COMPILE=true    # compile the result and repair once
# MAX_UPLOAD_MB=32             # hard request-body limit for every route

# -----------------------------------------------------------------------------
# Availability and the fallback (ai_status.py)
# -----------------------------------------------------------------------------
# Before any processing starts, the app checks whether the AI can be used and
# warns the user if it cannot, rather than silently producing a worse document.
# The check costs no quota: it reads configuration plus a remembered record of
# the last real failure. A pre-flight probe would consume exactly the free-tier
# quota that runs out, causing the outage it is meant to detect.
#
# Outages are remembered PER MODEL, not per service - a free-tier daily quota
# is spent one model at a time, so one model being out says nothing about the
# others. Each record expires at the retry time the provider itself supplied,
# and otherwise after this many seconds, so the app cannot get stuck on the
# fallback after a model has recovered. A successful call clears that model's
# record at once.
# AI_OUTAGE_ASSUME_SECONDS=900
#
# Force the local path for every conversion. Users are still warned and still
# get the choice; they simply cannot reach the AI path.
# AI_FIRST=true

# -----------------------------------------------------------------------------
# The local fallback pipeline (convert.py + layout.py)
# -----------------------------------------------------------------------------
# Tesseract and pix2text run over the same page and are merged by position.
# Measured against the AI path: structure 95.83% vs 100%, maths 95.47% vs
# 99.81% on the page corpus, and 93.06% vs 100% on isolated formulas.
# UNIFIED_MAX_PDF_PAGES=10     # pages rasterised from a PDF
# UNIFIED_CONF_FLOOR=50        # Tesseract confidence below which a non-prose
#                              # region is treated as mathematics and sent to
#                              # the formula model. Measured on bench/img_pages:
#                              # garbled maths lands at 31-41, correctly read
#                              # table rows at 93-96. Lower it to catch more
#                              # equations, raise it to catch fewer.

# Equation segmentation.
# EQUATION_MAX_REGIONS=12      # most equations detected on one page

# Image preprocessing (deskew / EXIF rotation / low-DPI upscale / alpha flatten).
# Measured in bench/: deskew takes a 10-degree page from 28% to 99.8% accuracy.
# OCR_PREPROCESS=true

# Result retention. Generated .tex files and their compiled PDF previews are
# deleted after this long, and are only ever served to the session that made them.
# TEX_STORE_TTL_SECONDS=3600

# LaTeX engine, used for the PDF preview and to validate generated documents.
# Auto-detected from PATH (pdflatex, xelatex, lualatex, tectonic).
# Without one the app still works: the .tex downloads and copies normally, and
# the preview shows a clear message instead of a rendered page.
# LATEX_CMD=C:\Program Files\MiKTeX\miktex\bin\x64\pdflatex.exe
# LATEX_COMPILE_TIMEOUT=120

# The preview is shown as page images rather than as the PDF itself, because a
# browser hands an application/pdf response to its own viewer - or to a
# download manager extension - before the page can display it. This is the
# resolution those images are rendered at.
# PREVIEW_DPI=110
