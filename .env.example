# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here
FLASK_DEBUG=True
PORT=5000

# Upload Configuration
UPLOAD_FOLDER=uploads

# OCR Binaries
# Tesseract is auto-detected from PATH; set this only to pin an explicit path.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Firebase Admin SDK (server-side)
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/your-firebase-adminsdk.json
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# Firebase Web SDK (client-side, used by the Google sign-in button on /login)
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
