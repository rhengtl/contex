rules_version = '2';

// DENY EVERYTHING FROM THE CLIENT
// --------------------------------
// The Worker reaches Firestore with a service account (worker/firebase.js),
// which authenticates as the project and bypasses these rules entirely. It
// scopes every read and write by the uid in the signed session cookie
// (worker/history.js), and that is the control that protects the data.
//
// No browser code reads or writes Firestore directly, and none is planned:
// the page uses the Firebase SDK for one thing only -- the Google sign-in
// popup -- and signs out of it again the moment it has an ID token.
//
// So these rules deny everything. An earlier version allowed a signed-in user
// owner-scoped access to their own documents, in case a client path was ever
// added. It never was, and the allowance had a cost: with the public Web API
// key and any Firebase ID token, a user could write their own ocr_history rows
// directly -- past the Worker's truncation, its rate limit and its per-user
// cap -- and fill the project's storage. A door nothing uses is a door that
// only an attacker walks through. Closed.
//
// If a direct client path is ever wanted, reopen it deliberately, for one
// collection, with the field and size checks the Worker applies, and add the
// case to tests/firestore.rules.test.mjs.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
