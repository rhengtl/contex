# Line endings.
#
# The application is developed on Windows and served from Cloudflare's edge, so
# what is stored in the repository has to be LF regardless of who committed it.
# Every text blob in this repository is already LF; this keeps it that way when
# someone clones on Windows with core.autocrlf set.
* text=auto eol=lf

*.sh            text eol=lf

# Binary assets. Marking them explicitly stops Git attempting line-ending
# conversion or a textual diff on them.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.ico           binary
*.pdf           binary
*.woff          binary
*.woff2         binary

# Generated, and reviewed by regenerating rather than by reading the diff.
# app.css comes from edge/design/app.src.css via `npm run build:css`; the page
# files come from edge/pages/ via `npm run build:pages`.
edge/public/app.css     linguist-generated=true
package-lock.json       linguist-generated=true
edge/package-lock.json  linguist-generated=true

# GitHub's language statistics should describe the application, not the
# benchmark corpus, the frozen parity data, or the committed build output.
bench/**                linguist-vendored=true
edge/tests/corpus/**    linguist-vendored=true
edge/tests/reference/** linguist-vendored=true
edge/public/app.css     linguist-detectable=false
