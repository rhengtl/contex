# Pull the published image and restart the app if - and only if - it changed.
#
# This is the second half of the deployment pipeline. GitHub Actions builds an
# arm64 image and pushes it to GHCR; this pulls it. `docker compose up -d`
# recreates a container only when its image digest has moved, so on the many
# runs where nothing has been published this does nothing at all and the
# running app is not touched.
#
# WHY PULL RATHER THAN LET CI PUSH. A workflow that can SSH into this machine
# needs a private key stored in GitHub and port 22 open to GitHub's address
# ranges. That trades a compromise of the CI system for a compromise of the
# server. Polling costs a couple of minutes of delay and needs no inbound
# access and no key at all.

[Unit]
Description=Update ConTeX to the latest published image
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/contex
ExecStart=/usr/bin/docker compose pull --quiet app
ExecStart=/usr/bin/docker compose up -d
# The image the pull just replaced is now untagged and would otherwise sit on
# the boot volume for ever. Each one is several gigabytes.
ExecStart=/usr/bin/docker image prune -f
